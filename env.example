# Required for real web search
TAVILY_API_KEY=

# Required for AI qualification and email writing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required for persistent storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=

# Required for Apollo contact discovery
APOLLO_API_KEY=

# Optional security gate. Enter the same value in the app Settings screen.
APP_ACCESS_TOKEN=

# Microsoft 365 / Outlook integration (requires admin consent)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=
# Keep false until Symbio IT approves direct sending.
ALLOW_DIRECT_SEND=false
# Supabase schema must include services and contact phone columns (run supabase/schema.sql).
