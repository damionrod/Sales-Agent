# Required for real web search
TAVILY_API_KEY=

# Required for AI qualification and email writing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required for persistent storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=

# Required for Apollo contact discovery
APOLLO_API_KEY=

# Optional security gate. Enter the same value in the app Settings screen.
APP_ACCESS_TOKEN=
